# 手元で動かすときは、このファイルを .env.local にコピーして値を入れる（.env.local はコミットしない）
# 本番は Vercel の環境変数に設定する

# Auth.js がログインの Cookie を暗号化する秘密の値（`npx auth secret` などで作る）
AUTH_SECRET=

# Google Cloud で作った OAuth のクライアントの ID と秘密の値
AUTH_GOOGLE_ID=
AUTH_GOOGLE_SECRET=

# ログインを許可するメールアドレス（カンマ区切り。大文字・小文字は区別しない。空ならだれもログインできない）
ALLOWED_EMAILS=
