# 手元で動かすときは、このファイルを .env.local にコピーして値を入れる（.env.local はコミットしない）
# 本番は Vercel の環境変数に設定する

# Auth.js がログインの Cookie を暗号化する秘密の値（`npx auth secret` などで作る）
AUTH_SECRET=

# Google Cloud で作った OAuth のクライアントの ID と秘密の値
AUTH_GOOGLE_ID=
AUTH_GOOGLE_SECRET=

# ログインを許可するメールアドレス（カンマ区切り。大文字・小文字は区別しない。空ならだれもログインできない）
ALLOWED_EMAILS=

# ノートを読むフォルダ。手元では、手元の保管庫の notes/ フォルダを指す（アプリのリポジトリに content/ はない）。
# Vercel では設定しない（ビルドのときに保管庫を content/ に取ってくる）
CONTENT_DIR=../learning-vault/notes

# 以下は Vercel の環境変数（Production と Preview）にだけ置く。手元では使わない（手順は docs/vault.md）
# 保管庫のリポジトリ（<持ち主>/<リポジトリ名>）
# VAULT_REPO=
# 保管庫を読むだけの鍵（fine-grained のトークン。learning-vault だけ・Contents の読むだけ）
# VAULT_TOKEN=
