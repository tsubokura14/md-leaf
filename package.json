{
  "name": "md-leaf",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "node scripts/prepare-content.mjs && next build",
    "start": "next start",
    "test": "vitest run",
    "lint": "eslint && node scripts/check-tokens.mjs",
    "check:content": "node scripts/check-content.mjs",
    "typecheck": "next typegen && tsc --noEmit",
    "test:visual": "node scripts/playwright-docker.mjs --update-snapshots=none",
    "screenshots": "node scripts/playwright-docker.mjs --update-snapshots=changed",
    "format": "prettier --write \"**/*.{ts,tsx,js,mjs,cjs,jsx,css,json}\""
  },
  "dependencies": {
    "kinari-md": "github:tsubokura14/kinari-md#v0.2.0",
    "next": "16.4.6",
    "next-auth": "5.0.0-beta.32",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "remark-frontmatter": "5.0.0",
    "remark-gfm": "4.0.1",
    "remark-math": "6.0.0",
    "remark-parse": "11.0.0",
    "unified": "11.0.5",
    "yaml": "2.9.1"
  },
  "devDependencies": {
    "@playwright/test": "1.65.0",
    "@tailwindcss/turbopack": "4.3.3",
    "@testing-library/dom": "^10.4.2",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.3",
    "@types/node": "^24.19.2",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "16.4.6",
    "eslint-plugin-better-tailwindcss": "^4.11.0",
    "jsdom": "^31.0.0",
    "prettier": "3.9.10",
    "tailwindcss": "4.3.3",
    "typescript": "^5",
    "vitest": "^5.1.0"
  }
}
